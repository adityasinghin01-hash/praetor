.env
.venv/
.venv-mlx/
__pycache__/
*.pyc
.adk/
.pytest_cache/

# DocILE is token-gated — never commit the corpus
data/docile/
data/*.zip

# local run artefacts
out/
finetune/data/
# LoRA checkpoints. The FINAL adapter is committed -- it is the artifact behind a
# published number and it makes FINDINGS 24 reproducible without a GPU. The
# intermediate ones are 8 MB each and derive from the same run.
finetune/adapters/*/0*_adapters.safetensors
*.log
.playwright-mcp/

# The web app's build products. `web/src` is committed; `web/dist` is derived, and
# DECISIONS #16 is about what committed derived artifacts do when they go stale.
web/node_modules/
web/dist/

# Terraform. The code is committed; the state, the lock and the downloaded provider are
# derived — and the state can contain resource attributes that should not be in git.
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
